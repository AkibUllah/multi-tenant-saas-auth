# Application
APP_NAME=multi-tenant-saas-auth
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (SQLite for local dev, Postgres in docker compose)
DATABASE_URL=sqlite:///./saas_auth.db
# DATABASE_URL=postgresql+psycopg://saas:saas@db:5432/saas_auth

# Redis (optional). When unset, rate limiting uses an in-process store.
# REDIS_URL=redis://redis:6379/0

# Tokens
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_TOKEN_TTL_SECONDS=86400
INVITATION_TTL_SECONDS=604800

# Passwords & brute-force protection
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Rate limiting for /v1/auth/* endpoints (per client IP)
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Email: "console" prints to stdout, "memory" keeps messages in-process (tests)
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.com
FRONTEND_BASE_URL=http://localhost:3000
